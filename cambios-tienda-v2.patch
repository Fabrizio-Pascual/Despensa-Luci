diff --git a/app/globals.css b/app/globals.css
index 73735ef..e7853c7 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -351,6 +351,57 @@ body {
   background-clip: text;
   color: transparent;
 }
+/* === Rediseño: botones, carteles y microanimaciones (solo tokens del tema) === */
+
+/* Brillo que cruza el botón principal al pasar el mouse / tocar */
+.btn-shine { position: relative; overflow: hidden; isolation: isolate; }
+.btn-shine::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background: linear-gradient(110deg, transparent 30%, color-mix(in oklch, white 38%, transparent) 50%, transparent 70%);
+  transform: translateX(-120%);
+}
+.btn-shine:hover::after { transform: translateX(120%); transition: transform 700ms ease; }
+
+/* Latido suave para llamar la atención (ofertas, "Quedan pocos") */
+@keyframes soft-pulse {
+  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 color-mix(in oklch, var(--primary) 35%, transparent); }
+  50% { transform: scale(1.05); box-shadow: 0 0 0 6px color-mix(in oklch, var(--primary) 0%, transparent); }
+}
+.pulse-soft { animation: soft-pulse 2.4s ease-in-out infinite; }
+
+/* Cartel tipo cinta para ofertas / novedades */
+.ribbon {
+  display: inline-flex; align-items: center; gap: 0.25rem;
+  background: linear-gradient(135deg, var(--primary), var(--accent));
+  color: var(--primary-foreground);
+  font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
+  padding: 0.3rem 0.7rem; border-radius: 9999px;
+  box-shadow: 0 6px 16px color-mix(in oklch, var(--primary) 35%, transparent);
+}
+
+/* Cascada: cada hijo entra con un pequeño retraso (hasta 12) */
+.reveal-sequential > *:nth-child(5) { animation-delay: 320ms; }
+.reveal-sequential > *:nth-child(6) { animation-delay: 400ms; }
+.reveal-sequential > *:nth-child(7) { animation-delay: 480ms; }
+.reveal-sequential > *:nth-child(8) { animation-delay: 560ms; }
+.reveal-sequential > *:nth-child(n+9) { animation-delay: 640ms; }
+
+/* Botón redondo de "agregar": rebote al tocar */
+.tap-pop { transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1), background-color 200ms, color 200ms; }
+.tap-pop:hover { transform: scale(1.12) rotate(-6deg); }
+.tap-pop:active { transform: scale(0.88); }
+
+/* Imagen con zoom lento y brillo al entrar el mouse */
+.img-zoom { transition: transform 700ms cubic-bezier(0.4, 0, 0.2, 1), filter 400ms; }
+.group:hover .img-zoom { transform: scale(1.08); filter: saturate(1.08); }
+
+/* Subrayado animado para links de texto */
+.link-underline { background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat; transition: background-size 300ms; }
+.link-underline:hover { background-size: 100% 2px; }
+
 /* ============================================================
    Accesibilidad: respeta la preferencia del sistema operativo
    "reducir movimiento". Apaga animaciones decorativas (reveal,
@@ -380,3 +431,8 @@ body {
     transform: none !important;
   }
 }
+
+@media (prefers-reduced-motion: reduce) {
+  .pulse-soft, .btn-shine::after { animation: none !important; transition: none !important; }
+  .tap-pop:hover, .group:hover .img-zoom { transform: none !important; }
+}
